# Qloo API key (hackathon key)
QLOO_API_KEY=
# Qloo base URL: hackathon keys use https://hackathon.api.qloo.com
QLOO_BASE_URL=
# Optional. live (default): cache first, API on miss. replay: cache only. refresh: always call the API.
QLOO_MODE=
# Optional. postgres (default) or file (.cache/qloo, for offline work and tests)
QLOO_CACHE_BACKEND=
# Optional. Directory for the file cache backend
QLOO_CACHE_DIR=
# Optional. Vertex model ids; defaults claude-opus-4-6 and claude-haiku-4-5 (Claude 5.x not yet enabled for the project)
CLAUDE_PLANNER_MODEL=
CLAUDE_CLASSIFIER_MODEL=
# Postgres connection string: matches the docker-compose default
DATABASE_URL=
# Local dev only: path to a service-account JSON OUTSIDE the repo; unset on Cloud Run
GOOGLE_APPLICATION_CREDENTIALS=
# Google Cloud project that hosts Claude on Vertex AI
GOOGLE_CLOUD_PROJECT=
# Vertex region: global unless the project is regionally allow-listed
ANTHROPIC_VERTEX_REGION=
# Shared secret for POST /api/jobs/ingest
INGEST_JOB_SECRET=
# MapLibre style JSON URL
PUBLIC_MAP_STYLE_URL=
# Public base URL of the app (e.g. http://localhost:5173 in dev)
APP_BASE_URL=
# Optional. Briefs allowed to run at the same time per instance (default 2); the next MAX_QUEUED_RUNS
# (default 6) wait in a queue and start on their own; beyond that requests get 429
MAX_CONCURRENT_RUNS=
MAX_QUEUED_RUNS=
# Optional. on runs the tool-less counterfactual next to every brief (default off; the document no longer shows it)
COUNTERFACTUAL_RUN=
# Optional. vertex (default) or fake: a canned trace for end-to-end tests, never for real briefs
AGENT_RUNNER=
# Optional. true applies pending Drizzle migrations when the server starts (used on Cloud Run)
MIGRATE_ON_START=
