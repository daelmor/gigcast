{
	"name": "gigcast",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up -d db",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"probe": "tsx scripts/qloo-probe.ts",
		"brief": "tsx scripts/brief.ts",
		"briefs:dedupe": "tsx scripts/dedupe-briefs.ts",
		"stats": "tsx scripts/stats.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@neon/config": "^1.9.5",
		"@neon/env": "^1.6.6",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/ngeohash": "^0.6.8",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@anthropic-ai/vertex-sdk": "^1.1.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/sora": "^5.3.0",
		"drizzle-orm": "^0.45.4",
		"echarts": "^6.1.0",
		"fast-xml-parser": "^5.11.2",
		"maplibre-gl": "^6.16.0",
		"nanoid": "^6.0.2",
		"ngeohash": "^0.6.4",
		"pino": "^10.4.0",
		"postgres": "^3.4.9",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.16.1"
}
